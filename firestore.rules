rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profilo utente e posizione: visibili a tutti gli utenti autenticati (per sistema amici e radar)
    // Modificabili ESCLUSIVAMENTE dal proprietario
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Sottocollezione corse personali (rides): privata dell'utente
      match /rides/{rideId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /{document=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Canali e sessioni interfono tra compagni di moto
    match /intercom_channels/{channelId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Default deny per tutto il resto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
